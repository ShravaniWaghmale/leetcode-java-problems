class Solution {
    public int sumOfUnique(int[] nums) {
        int[] count = new int[101];

        // Count frequency
        for (int num : nums) {
            count[num]++;
        }

        // Add elements appearing exactly once
        int sum = 0;
        for (int i = 1; i <= 100; i++) {
            if (count[i] == 1) {
                sum += i;
            }
        }

        return sum;
    }
}
