class Solution {
    public int[] getSneakyNumbers(int[] nums) {
        int[] count = new int[nums.length];
        int[] result = new int[2];
        int index = 0;

        for (int num : nums) {
            count[num]++;

            if (count[num] == 2) {
                result[index++] = num;
            }
        }

        return result;
    }
}
