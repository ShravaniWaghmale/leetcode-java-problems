class Solution {
    public int[] kWeakestRows(int[][] mat, int k) {
        int m = mat.length;
        int n = mat[0].length;

        int[][] soldiers = new int[m][2];

        for (int i = 0; i < m; i++) {
            int left = 0;
            int right = n - 1;

            // Count soldiers using binary search
            while (left <= right) {
                int mid = left + (right - left) / 2;

                if (mat[i][mid] == 1) {
                    left = mid + 1;
                } else {
                    right = mid - 1;
                }
            }

            soldiers[i][0] = left; // Number of soldiers
            soldiers[i][1] = i;    // Row index
        }

        // Sort by soldier count, then by row index
        Arrays.sort(soldiers, (a, b) -> {
            if (a[0] != b[0]) {
                return a[0] - b[0];
            }
            return a[1] - b[1];
        });

        int[] result = new int[k];

        for (int i = 0; i < k; i++) {
            result[i] = soldiers[i][1];
        }

        return result;
    }
}
