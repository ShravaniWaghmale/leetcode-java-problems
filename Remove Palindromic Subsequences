class Solution {
    public int removePalindromeSub(String s) {

        int left = 0;
        int right = s.length() - 1;

        // Check if the entire string is a palindrome
        while (left < right) {
            if (s.charAt(left) != s.charAt(right)) {
                return 2;
            }

            left++;
            right--;
        }

        return 1;
    }
}
