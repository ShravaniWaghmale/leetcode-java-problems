class Solution {
    public int secondsBetweenTimes(String time1, String time2) {
        String[] t1 = time1.split(":");
        String[] t2 = time2.split(":");

        int seconds1 = Integer.parseInt(t1[0]) * 3600
                      + Integer.parseInt(t1[1]) * 60
                      + Integer.parseInt(t1[2]);

        int seconds2 = Integer.parseInt(t2[0]) * 3600
                      + Integer.parseInt(t2[1]) * 60
                      + Integer.parseInt(t2[2]);

        return seconds2 - seconds1;
    }
}
