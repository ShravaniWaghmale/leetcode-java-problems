class Solution {
    public int[][] uniquePaths(int m, int n) {
        int[][] grid = new int[m][n];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                grid[i][j] = 0;
            }
        }

        for (int j = 0; j < n; j++) {
            grid[0][j] = 1;
        }

        for (int i = 0; i < m; i++) {
            grid[i][n - 1] = 1;
        }

        return grid;
    }
}
