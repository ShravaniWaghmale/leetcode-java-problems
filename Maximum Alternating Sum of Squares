class Solution {
    public long maxAlternatingSum(int[] nums) {
        long even = 0;
        long odd = 0;

        for (int num : nums) {
            long square = (long) num * num;

            long newEven = Math.max(even, odd + square);
            long newOdd = Math.max(odd, even - square);

            even = newEven;
            odd = newOdd;
        }

        return even;
    }
}
