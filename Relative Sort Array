import java.util.*;

class Solution {
    public int[] relativeSortArray(int[] arr1, int[] arr2) {
        int[] result = new int[arr1.length];
        int index = 0;

        // Count the frequency of each number
        int[] freq = new int[1001];

        for (int num : arr1) {
            freq[num]++;
        }

        // Add elements in the order specified by arr2
        for (int num : arr2) {
            while (freq[num] > 0) {
                result[index++] = num;
                freq[num]--;
            }
        }

        // Add remaining elements in ascending order
        for (int i = 0; i < freq.length; i++) {
            while (freq[i] > 0) {
                result[index++] = i;
                freq[i]--;
            }
        }

        return result;
    }
}
