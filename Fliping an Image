class Solution {
    public int[][] flipAndInvertImage(int[][] image) {
        int n = image.length;

        for (int[] row : image) {

            // Flip the row
            int left = 0, right = n - 1;
            while (left < right) {
                int temp = row[left];
                row[left] = row[right];
                row[right] = temp;
                left++;
                right--;
            }

            // Invert the row
            for (int i = 0; i < n; i++) {
                row[i] ^= 1;   // 0 -> 1, 1 -> 0
            }
        }

        return image;
    }
}
